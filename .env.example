# ============================================================
#  CAU HINH MAY CHU THU VIEN
#  Chep tep nay thanh  .env  roi dien thong tin that.
#  KHONG chia se tep .env va khong day len GitHub.
# ============================================================

PORT=4000
# Mat khau dang nhap cua quan tri vien (dung cho API)
ADMIN_PASSWORD=doi-mat-khau-nay
# Chuoi bi mat de ky phien dang nhap (tu go ngau nhien >32 ky tu)
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-that-dai

# Gio chay kiem tra han tra hang ngay (dinh dang cron, mac dinh 8h00 sang)
CRON_SCHEDULE=0 8 * * *
TIMEZONE=Asia/Ho_Chi_Minh

# Lich nhac: 1 = bat, 0 = tat
NOTIFY_BEFORE_3=1
NOTIFY_BEFORE_1=1
NOTIFY_ON_DUE=1
NOTIFY_OVERDUE=1

# ============================================================
#  SMS  — chon MOT nha cung cap
#  SMS_PROVIDER = twilio | esms | none
# ============================================================
SMS_PROVIDER=none

# --- Twilio (quoc te) ---
# Lay tai https://console.twilio.com  -> Account SID va Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# So gui do Twilio cap, dang quoc te: +12025550123
TWILIO_FROM=

# --- eSMS.vn (Viet Nam) ---
# Lay tai https://esms.vn -> Quan ly API -> ApiKey / SecretKey
ESMS_API_KEY=
ESMS_SECRET_KEY=
# Brandname da dang ky voi eSMS, vi du: THUVIEN
ESMS_BRANDNAME=
# 2 = tin CSKH brandname, 8 = tin quang cao; hoi eSMS neu khong chac
ESMS_SMS_TYPE=2

# ============================================================
#  EMAIL
#  EMAIL_PROVIDER = gmail | smtp | none
# ============================================================
EMAIL_PROVIDER=none

# --- Gmail ---
# 1. Bat xac minh 2 buoc cho tai khoan Google
# 2. Vao https://myaccount.google.com/apppasswords tao "Mat khau ung dung"
# 3. Dan chuoi 16 ky tu (bo dau cach) vao GMAIL_APP_PASSWORD
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Thu vien lop

# --- SMTP khac (neu khong dung Gmail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# So dien thoai va email dung cho lenh: npm run test-send
TEST_PHONE=
TEST_EMAIL=
